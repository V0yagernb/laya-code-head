+def metric_0(rows):
+    """第 0 个统计口径。"""
+    counter = Counter(
+        r.get("field_0") for r in rows if r.get(f"enabled_0", True)
+    )
+    total = sum(counter.values()) or 1
+    return {k: v / total for k, v in counter.items()}
